<?xml version="1.0" encoding="UTF-8"?>
<!--
  根构建：版本单一来源 + Boot BOM + 插件版本统一。

  与 Gradle 时代的对应关系：
    gradle/libs.versions.toml        → 本文件 <properties>
    build-logic 的 java-conventions  → compiler 配置（release 21 / -parameters / UTF-8）
    build-logic 的 test-conventions  → surefire 配置（JUnit Platform / 动态 agent 加载）
    allprojects { repositories }     → 仓库声明（镜像走 ~/.m2/settings.xml，不写进 pom）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ragagent</groupId>
  <artifactId>ragagent-parent</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ragagent-java</name>

  <modules>
    <module>contract</module>
    <module>platform</module>
    <module>model-runtime</module>
    <module>retrieval-engine</module>
    <module>agent-engine</module>
    <module>domains</module>
    <module>boot</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <contract.refresh>false</contract.refresh>
    <!-- Mockito inline 在 JDK 21+ 自挂 attach 会被拒 ⇒ -XX:+EnableDynamicAgentLoading。
         同时 jacoco 的 prepare-agent 会在这个属性上**前置** -javaagent，
         所以 surefire 必须引用属性而非字面量，否则 -Pcoverage 时 agent 挂不上。 -->
    <argLine>-XX:+EnableDynamicAgentLoading</argLine>

    <!-- 平台线：Boot BOM 统一 starter-*/flyway/h2/junit 等版本，其余在此登记 -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <!-- protoc 与 BOM 的 protobuf-java 对齐：3.25 生成的 GeneratedMessageV3 在 4.x 运行时会刷废弃警告，
         与 -Werror 相撞（实测 platform 编译直接失败） -->
    <protobuf.version>4.35.1</protobuf.version>
    <grpc.version>1.66.0</grpc.version>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <archunit.version>1.3.0</archunit.version>
    <jjwt.version>0.12.6</jjwt.version>
    <awssdk.version>2.31.68</awssdk.version>
    <duckdb.version>1.1.3</duckdb.version>
    <grpc-client-starter.version>3.1.0.RELEASE</grpc-client-starter.version>
    <javax-annotation.version>1.3.2</javax-annotation.version>
    <jtokkit.version>1.1.0</jtokkit.version>
    <aliyun-oss.version>3.18.1</aliyun-oss.version>
    <qcloud-cos.version>5.6.227</qcloud-cos.version>
    <volcengine-tos.version>2.9.19</volcengine-tos.version>
    <springdoc.version>3.1.1</springdoc.version>
    <!-- springdoc 传递到 2.2.55；BOM 不管这一项，显式对齐 Gradle 实测值 -->
    <swagger-annotations.version>2.2.55</swagger-annotations.version>
    <jakarta-servlet.version>6.1.0</jakarta-servlet.version>

    <!-- 插件版本 -->
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
    <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>
    <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
    <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
    <build-helper-maven-plugin.version>3.6.1</build-helper-maven-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
    <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 平台 BOM：只此一处，子模块不得自行 import -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 本仓模块：Maven 不做版本推断，模块间依赖统一在此定版 -->
      <dependency>
        <groupId>com.ragagent</groupId>
        <artifactId>contract</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ragagent</groupId>
        <artifactId>platform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ragagent</groupId>
        <artifactId>model-runtime</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ragagent</groupId>
        <artifactId>retrieval-engine</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ragagent</groupId>
        <artifactId>agent-engine</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ragagent</groupId>
        <artifactId>domains</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 带显式版本者（原 libs.versions.toml 的 libraries 段） -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-jsqlparser</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <!-- protobuf-java / grpc-protobuf / grpc-stub 的**运行时库版本归 Boot BOM**
           （Gradle 侧同口径：BOM 覆盖显式声明，实测解析到 protobuf 4.35.1 / grpc 1.83.1）。
           ${protobuf.version} 与 ${grpc.version} 只用于 protoc / protoc-gen-grpc-java 二进制。 -->
      <dependency>
        <groupId>net.devh</groupId>
        <artifactId>grpc-client-spring-boot-starter</artifactId>
        <version>${grpc-client-starter.version}</version>
      </dependency>
      <dependency>
        <groupId>javax.annotation</groupId>
        <artifactId>javax.annotation-api</artifactId>
        <version>${javax-annotation.version}</version>
      </dependency>
      <!-- neo4j / sqlite 亦归 Boot BOM（Gradle 实测：6.1.0 / 3.53.2.1） -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>s3</artifactId>
        <version>${awssdk.version}</version>
      </dependency>
      <dependency>
        <groupId>com.aliyun.oss</groupId>
        <artifactId>aliyun-sdk-oss</artifactId>
        <version>${aliyun-oss.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qcloud</groupId>
        <artifactId>cos_api</artifactId>
        <version>${qcloud-cos.version}</version>
      </dependency>
      <dependency>
        <groupId>com.volcengine</groupId>
        <artifactId>ve-tos-java-sdk</artifactId>
        <version>${volcengine-tos.version}</version>
      </dependency>
      <dependency>
        <groupId>org.duckdb</groupId>
        <artifactId>duckdb_jdbc</artifactId>
        <version>${duckdb.version}</version>
      </dependency>
      <dependency>
        <groupId>com.knuddels</groupId>
        <artifactId>jtokkit</artifactId>
        <version>${jtokkit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <!-- BOM 不管 swagger 注解；显式钉 Gradle 实测值，避免 Maven 的「最近优先」退化到旧版 -->
      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-annotations-jakarta</artifactId>
        <version>${swagger-annotations.version}</version>
      </dependency>

      <!-- Guava 的 jre / android 是**版本后缀**两种变体：Maven 的「最近优先」会选到 android，
           而 Gradle 取 jre。android 变体缺部分 JRE 类，运行期会 NoClassDefFoundError -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.6.0-jre</version>
      </dependency>

      <!-- servlet API 必须 provided：否则会被某个 compile 传递依赖带进 fat jar，
           与 tomcat-embed-core 自带的类重复。版本与 BOM 同步（升级 Boot 时核对）。 -->
      <dependency>
        <groupId>jakarta.servlet</groupId>
        <artifactId>jakarta.servlet-api</artifactId>
        <version>${jakarta-servlet.version}</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <extensions>
      <!-- 提供 ${os.detected.classifier}：protoc / protoc-gen-grpc-java 按平台取二进制 -->
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>${os-maven-plugin.version}</version>
      </extension>
    </extensions>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${java.version}</release>
            <!-- MyBatis 无 @Param 的参数绑定、Spring MVC/Jackson 参数名反射都依赖它 -->
            <parameters>true</parameters>
            <encoding>${project.build.sourceEncoding}</encoding>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- @{...} 是 surefire 的**晚绑定**语法（${...} 在配置期就被解析，jacoco 的
                 prepare-agent 后置设置就读不到）⇒ -Pcoverage 时 -javaagent 才能挂上 -->
            <argLine>@{argLine}</argLine>
            <!-- 与 Gradle 的 maxParallelForks 同口径：按测试类分派到 2 个 JVM。
                 Gradle 侧按核数自适应（根 cores/4、domains/boot cores/2），Maven 无内建核数属性，
                 取固定的 2：本机接近、CI（4 核 × 2g fork）也不会 OOM。 -->
            <forkCount>2</forkCount>
            <reuseForks>true</reuseForks>
            <!-- 测试沙箱：DOCREADER_ADDR 一律置空，避免继承 shell 里 source 过的 dev-env.sh -->
            <environmentVariables>
              <DOCREADER_ADDR></DOCREADER_ADDR>
            </environmentVariables>
            <!-- 契约夹具重录开关：-Dcontract.refresh=true 时写回金片（平时是断言） -->
            <systemPropertyVariables>
              <contract.refresh>${contract.refresh}</contract.refresh>
            </systemPropertyVariables>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>

        <!-- 各模块的 Javadoc 共用一个门槛：只启用 doclint 的「引用」检查组。
             理由：本仓真实漂移过多次 —— 改名/搬家后注释里的 {@link}/{@code}/{@see} 还指着旧类型
             （此前人工修过 ≥5 次）。交给 javadoc 自己的解析器判定，零维护成本；
             HTML 风格（</p>、heading 顺序）与 @param 完整性刻意不纳入 —— 噪声大、价值低。 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
          <configuration>
            <!-- 先关掉插件默认的 doclint=all，再用 additionalOptions 只开 reference -->
            <doclint>none</doclint>
            <additionalOptions>
              <additionalOption>-Xdoclint:reference</additionalOption>
              <additionalOption>-quiet</additionalOption>
              <additionalOption>-Xmaxerrs</additionalOption>
              <additionalOption>10000</additionalOption>
              <!-- 比 Gradle 侧更严一档：Gradle 的 javadoc 只告警不阻断，而 build.gradle.kts 的注释
                   本就宣称「构建期就红」。接入时实测全仓 0 条 reference warning，故收紧为阻断。 -->
              <additionalOption>-Werror</additionalOption>
            </additionalOptions>
          </configuration>
          <executions>
            <execution>
              <id>javadoc-check</id>
              <phase>verify</phase>
              <goals>
                <goal>javadoc</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-maven-plugin.version}</version>
        </plugin>

        <!-- 守卫：单入口 scripts/run-guards.sh（本地与 CI 同口径） -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>

        <plugin>
          <groupId>org.xolstice.maven.plugins</groupId>
          <artifactId>protobuf-maven-plugin</artifactId>
          <version>${protobuf-maven-plugin.version}</version>
        </plugin>

        <!-- testFixtures 源集：Gradle 有 `java-test-fixtures`，Maven 没有 ⇒ 挂进 test 源集，
             再用 test-jar 产出 -tests.jar 供跨模块消费（同模块测试直接可见，无循环依赖） -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build-helper-maven-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- 格式检查：ratchet 从 seed 起只检查后续触碰的文件（与 Gradle 的 spotless 同口径）。
           根模块无 java 源码 ⇒ 自动跳过；子模块继承本配置。 -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <ratchetFrom>seed</ratchetFrom>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
              <include>src/testFixtures/java/**/*.java</include>
            </includes>
            <!-- \# 前缀=static 块置顶，空串=其余单块 ASCII 序 -->
            <importOrder>
              <order>\#,</order>
            </importOrder>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 覆盖率：默认**不插桩**（jacoco agent 让全量闸门慢约 25%），显式 `-Pcoverage` 才采集。
         Gradle 侧有 doFirst 防呆（忘了加 -Pcoverage 直接报错）；Maven 没有等价拦截，
         不加 profile 时既不插桩也不出报告 —— 该差异已登记在方案 §3.3。 -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
