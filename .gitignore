# Java 构建产物（target/ = Maven；build/ 保留给运行期迁移脚本目录）
build/
target/
# IDE 的 Java 语言服务器（jdt.ls）编译输出
bin/
*.class
*.jar

# Node / 前端
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.tsbuildinfo
frontend/package.json.md5

# IDE
.idea/
.vscode/
*.iml
.claude/
.codebuddy/
.workbuddy/
.zcodeignore

# OS
.DS_Store

# 部署镜像构建暂存（jar/dist/镜像 tar，由 deploy/build-images.sh 生成）
deploy/.build/

# 本地环境
.env
*.local
/data/
# 内置模型声明（含真实凭据，只提交 .example）
config/builtin_models.yaml

# 测试产物

# BrowserSkill 本地构建产物（scripts/build_browserskill.sh 生成，含平台二进制）
artifacts/

# Python 缓存（route-recon 被 generate-api-docs import 时生成）
__pycache__/
*.pyc

# Python（mcp-server 工具）
mcp-server/.venv/
__pycache__/
*.egg-info/
.zcode/

# IDE 本地 AI 数据（.workbuddy-ai）
.workbuddy-ai/

# 本地工具输出（outputs）
/outputs/

# 生成的 API 文档站点（scripts/generate-api-docs.py 产物）
docs/site/

# 本地架构评估草稿（用户工作区，不入库）
docs/architecture-review/
