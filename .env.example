# =====================================================================
# ragagent-java 环境变量配置示例
# ---------------------------------------------------------------------
# 使用说明：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 替换所有占位符为实际值（尤其标 ⚠️ 必填 的项）
#   3. .env 已在 .gitignore，不会被提交
#
# 消费方：
#   - scripts/dev-env.sh 读本文件（SYSTEM_AES_KEY/DB_*/REDIS_PASSWORD 六个必读键），
#     供 java-server-up.sh / token.sh / 全部测试脚本使用；
#   - docker-compose.yml 的 postgres/redis 容器密码需与此处保持一致。
#   - 应用本身不解析 .env：由脚本/编排注入为进程环境变量后再启动 Java。
#
# 键名沿用既有部署约定（DB_/REDIS_/SYSTEM_AES_KEY/…）；dev 端口约定：
# postgres 15432 / redis 16379 / app 8083。
# =====================================================================

# ── 数据库（⚠️ 必填；与 docker-compose.yml 的 postgres 容器一致） ─────────
# 驱动固定 postgres；pg_search（ParadeDB BM25）与 pgvector 扩展为检索引擎依赖，
# 需用 paradedb/paradedb 镜像（见 docker-compose.yml）。
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD=postgres123!@#
DB_NAME=WeKnora

# ── Redis（⚠️ 必填；走查脚本与测试基建依赖） ──────────────────────────────
# 多实例部署时各域还有各自的开关（见文末"多实例部署"节）。
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=redis123!@#

# ── 认证与空间隔离（⚠️ SYSTEM_AES_KEY 必填） ─────────────────────────────
# 32 字节 AES 密钥：模型凭证加密 / 临时文档 / 租户隔离族共用。
# ⚠️ 更换后已加密列不可解——建库前定好，勿随意轮换。
SYSTEM_AES_KEY=0123456789abcdef0123456789abcdef

# ── 文档解析（docreader gRPC 服务；docker-compose 起在 50051） ────────────
DOCREADER_ADDR=localhost:50051

# ── 服务端口 ────────────────────────────────────────────────────────────
# Java 后端监听端口（缺省 8080）。
SERVER_PORT=8083

# ── 文档原始文件持久存储（本地 dev 必填） ────────────────────────────────
# 建议仓库外持久路径，如 ~/ragagent-data/files。
LOCAL_STORAGE_BASE_DIR=/Users/billy/ragagent-data/files

# ── 检索引擎（可选；HybridSearch 的 env-store 引擎选择） ──────────────────
# 缺省/为空 = 检索引擎关闭（HybridSearch 返回空）。
# postgres = pgvector + ParadeDB BM25（本仓 compose 的镜像自带两种扩展）。
# 其余取值（elasticsearch_v7/v8、qdrant、milvus、weaviate、doris、sqlite、
# tencent_vectordb、opensearch）对应各外部引擎实现；支持逗号分隔多引擎
# （精确匹配、不 trim）。
# RETRIEVE_DRIVER=postgres

# ── 流管理器（可选） ────────────────────────────────────────────────────
# memory（缺省，进程内）/ redis（跨实例共享；多实例或双环境共用键空间时两侧同设）。
# 前缀 REDIS_PREFIX 原样拼接、不裁尾部冒号（值需与既有部署的键名保持一致）。
# STREAM_MANAGER_TYPE=redis
# REDIS_PREFIX=stream:

# ── 多实例部署开关（可选；单机保持全部注释状态） ──────────────────────────
# 多实例部署时打开；每个开关在启动时 ping 一次 Redis，连不上则启动失败（不静默退化）。
# 各面的详细说明见 application.yml 同名注释；流管理器不在此组（见上一节）。
# IM_REDIS_ENABLED=true            # IM 六面：队列计数/去重/限流/跨实例 stop/广播/WS 选主
# WIKI_REDIS_ENABLED=true          # wiki 六面：锁族/任务队列/删除墓碑
# KNOWLEDGE_REDIS_ENABLED=true     # 知识域四面：两个队列 + FAQ 导入状态 + move/clone 进度
# MEMORY_REDIS_ENABLED=true        # 记忆蒸馏队列
# DATASOURCE_REDIS_ENABLED=true    # 数据源同步队列 + 全局 TaskID 去重
# EMBED_REDIS_ENABLED=true         # embed 公开面跨实例限流
# LLM_LIMITER_REDIS_ENABLED=true   # 模型并发闸门（分布式信号量）
# IM_GLOBAL_MAX_WORKERS=0          # 可选：IM 跨实例并发上限（0=不限）

# ── 内置模型声明（可选） ────────────────────────────────────────────────
# 声明式内置模型文件路径（缺省 ./config/builtin_models.yaml；文件不存在 = no-op）。
# 启动时按声明对账模型（补默认），文件格式见仓库样例。
# BUILTIN_MODELS_CONFIG=/path/to/builtin_models.yaml
