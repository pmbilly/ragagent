<?xml version="1.0" encoding="UTF-8"?>
<!--
  模型运行时：llm / modelruntime / embedding / rerank / modelcontext。

  依赖方向：model-runtime → platform → contract。对检索/问答/抓取包的出边为 0。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ragagent</groupId>
    <artifactId>ragagent-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>model-runtime</artifactId>
  <name>model-runtime</name>

  <dependencies>
    <dependency>
      <groupId>com.ragagent</groupId>
      <artifactId>platform</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ragagent</groupId>
      <artifactId>contract</artifactId>
    </dependency>

    <!-- 依实际 import 面声明（jackson / slf4j / spring-context / spring-web / spring-data-redis），
         不用 starter，避免把自动配置漏进库 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- EmbeddedRedis（Gradle: testFixtures(project(":platform"))） -->
    <dependency>
      <groupId>com.ragagent</groupId>
      <artifactId>platform</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
